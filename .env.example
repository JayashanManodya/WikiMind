# WikiMind Environment Configuration Example
APP_NAME=WikiMind
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# LLM & Embeddings Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here
EMBEDDING_MODEL=text-embedding-3-small

# Storage Paths
STORAGE_DIR=./storage
WIKI_DIR=./wiki
CHROMADB_DIR=./storage/chromadb
